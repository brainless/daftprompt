# Copy to `.env` (git-ignored) and fill in. Real environment variables take
# precedence over this file. Loaded by daftprompt-api and the live evaluation.

# --- Provider selection -----------------------------------------------------
# `openai` (default), `neuralwatt`, `cerebras`, or `groq`.
DAFTPROMPT_API_PROVIDER=openai
# Defaults to gpt-4o-mini for openai, glm-5.3-flash for neuralwatt,
# gpt-oss-120b for cerebras, and openai/gpt-oss-20b for groq.
# DAFTPROMPT_API_MODEL=gpt-4o-mini

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
# Optional OpenAI-compatible endpoint override.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Neuralwatt (OpenAI-compatible Chat Completions) ------------------------
NEURALWATT_API_KEY=your-neuralwatt-key-here
# Optional; default shown.
# NEURALWATT_BASE_URL=https://api.neuralwatt.com/v1

# --- Cerebras (OpenAI-compatible Chat Completions) ---------------------------
CEREBRAS_API_KEY=your-cerebras-key-here
# Optional; default shown.
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# --- Groq (OpenAI-compatible Chat Completions) -------------------------------
GROQ_API_KEY=your-groq-key-here
# Optional; default shown.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- API service ------------------------------------------------------------
# DAFTPROMPT_API_ADDR=127.0.0.1:8080
# DAFTPROMPT_API_MAX_INPUT_BYTES=32768
# DAFTPROMPT_API_MAX_SEGMENTS=1000
# DAFTPROMPT_API_MAX_ATTEMPTS=3
# DAFTPROMPT_API_TIMEOUT_SECS=60

# --- Live evaluation (evaluate-scribe) --------------------------------------
# DAFTPROMPT_EVAL_LIVE=1
# DAFTPROMPT_EVAL_PROVIDER=openai
# DAFTPROMPT_EVAL_MODEL=gpt-4o-mini
# DAFTPROMPT_EVAL_PROMPT_VERSION=scribe-v4
# DAFTPROMPT_EVAL_MAX_ATTEMPTS=3
# DAFTPROMPT_EVAL_TIMEOUT_SECS=60

# --- GUI (read by the GUI process from the real environment) ----------------
# Note: the GUI does not load .env itself; the API child it spawns does.
# DAFTPROMPT_API_URL=http://127.0.0.1:8080/parse
# DAFTPROMPT_GUI_TIMEOUT_SECS=300
# DAFTPROMPT_GUI_SPAWN_API=1
# DAFTPROMPT_API_BIN=/path/to/daftprompt-api

# POST /clarify (Explainer). Provider credentials are shared with Scribe.
# DAFTPROMPT_EXPLAINER_PROVIDER=neuralwatt
# DAFTPROMPT_EXPLAINER_MODEL=glm-5.3-flash
# For Cerebras: set provider=cerebras and model=gpt-oss-120b.
# For Groq: set provider=groq and model=openai/gpt-oss-20b.
# Optional: SQLite database file (default: the per-user data directory,
# e.g. ~/Library/Application Support/daftprompt/daftprompt.db on macOS).
# DAFTPROMPT_DB_PATH=/path/to/daftprompt.db
# Optional: fallback directory the Explainer may read when a request has no
# project_id (a request's registered project takes precedence; unset = text-only).
# DAFTPROMPT_PROJECT_ROOT=/path/to/project
